# Copy this file to `.env` and fill in the values.

# Gemini API key — free tier.
# Get one at https://aistudio.google.com/apikey (sign in with Google, click "Create API key").
# The free tier is enough for this project; see MODEL/FALLBACK_MODEL below.
GEMINI_API_KEY=

# Tavily API key — free tier (1000 credits/month on the free plan).
# Get one at https://app.tavily.com/home (sign up, then the API key is on the dashboard).
# This is the ONLY tool the agent has: web search.
TAVILY_API_KEY=

# Default timezone used to resolve relative dates ("Monday", "last Tuesday", "yesterday").
# Any IANA timezone name. The UI can override this per request.
USER_TIMEZONE=Asia/Kolkata

# HTTP port for the chat server.
PORT=3000

# ISO datetime that replaces the clock everywhere (date resolution, re-verify
# flow, stored timestamps). Useful for demos and evals, which need to replay
# the same day. Leave empty to use the real clock.
# NOW_OVERRIDE=2026-11-12T09:00:00.000Z

# Primary model. A stable (non-preview) Gemini Flash model.
#
# The Gemini free tier allows only ~20 generate-content requests PER DAY, per
# model, per project — and the quota is counted separately for each model. The
# agent therefore uses two different models so that exhausting one still leaves
# the other usable; the app switches automatically and tells you over SSE when
# it does. Raise these limits by adding billing in AI Studio.
#
# gemini-3.8-flash is the newest Flash. It is also the model most likely to
# saturate on the free tier (503 "high demand", or a connection that hangs
# without answering), which is why it gets a first-token deadline below.
MODEL=gemini-3.8-flash

# Used automatically if the primary model returns 429 (rate limit) or 5xx, or
# fails to produce its first token within PRIMARY_TTFT_TIMEOUT_MS.
FALLBACK_MODEL=gemini-3.5-flash-lite

# Model used for structured calls (claim extraction). Extraction is mechanical,
# so it does not need the answer model — and because the quota is counted per
# model, keeping it separate means extraction never eats the answer model's
# daily allowance.
STRUCTURED_MODEL=gemini-3.5-flash-lite

# How long the PRIMARY model has to produce its first token, in milliseconds.
# A saturated model often holds the connection open without answering; after
# this deadline the request fails over to FALLBACK_MODEL and the primary is
# taken out of rotation for 5 minutes. The fallback has no deadline: there is
# nowhere left to fail over to. Set to 0 to disable.
PRIMARY_TTFT_TIMEOUT_MS=5000
